      </script>

      <script>
  document.addEventListener("DOMContentLoaded", () => {
    const button = document.getElementById("exportPdfButton");
    if (!button) return;

    const label = button.querySelector(".export-button-label");
    const circle = button.querySelector(".export-progress-value");

const setProgress = (value) => {
  const percent = Math.max(0, Math.min(100, Math.round(value)));
  button.style.setProperty("--export-progress", percent);
};

    button.addEventListener("click", () => {
      if (button.classList.contains("is-exporting")) return;

      const url = button.dataset.url;
      const fallbackName = button.dataset.filename || "security-report.pdf";

      button.classList.add("is-exporting");
      button.disabled = true;
      label.textContent = "Preparing PDF";
      setProgress(0);

      let fakeProgress = 0;
      const fallbackTimer = setInterval(() => {
        if (fakeProgress < 88) {
          fakeProgress += 4;
          setProgress(fakeProgress);
        }
      }, 220);

      const xhr = new XMLHttpRequest();
      xhr.open("GET", url, true);
      xhr.responseType = "blob";

      xhr.onprogress = (event) => {
        if (event.lengthComputable) {
          const percent = Math.round((event.loaded / event.total) * 100);
          setProgress(percent);
        }
      };

      xhr.onload = () => {
        clearInterval(fallbackTimer);

        if (xhr.status < 200 || xhr.status >= 300) {
          button.classList.remove("is-exporting");
          button.disabled = false;
          label.textContent = "Export Full Report";
          setProgress(0);
          alert("PDF export failed. Please try again.");
          return;
        }

        setProgress(100);
        label.textContent = "Downloading";

        const blob = new Blob([xhr.response], { type: "application/pdf" });
        const blobUrl = URL.createObjectURL(blob);

        const link = document.createElement("a");
        link.href = blobUrl;
        link.download = fallbackName;
        document.body.appendChild(link);
        link.click();
        link.remove();

        setTimeout(() => {
          URL.revokeObjectURL(blobUrl);
          button.classList.remove("is-exporting");
          button.disabled = false;
          label.textContent = "Export Full Report";
          setProgress(0);
        }, 900);
      };

      xhr.onerror = () => {
        clearInterval(fallbackTimer);
        button.classList.remove("is-exporting");
        button.disabled = false;
        label.textContent = "Export Full Report";
        setProgress(0);
        alert("PDF export failed. Please try again.");
      };

      xhr.send();
    });
  });
</script>

  <% } %>
</body>
